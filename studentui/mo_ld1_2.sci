// Measurement-only adapters. Models/configuration/legacy callbacks remain unchanged.
// The student connects the actual meter and copies its observable reading.

function c=mo12_component(name,ids,labels)
    c=struct("name",name,"ids",matrix(ids,-1,1),"labels",matrix(labels,-1,1));
endfunction

function t=mo12_trial(key,title,condition,why,topology,wires,x)
    t=struct("key",key,"title",title,"condition",condition,"why",why, ...
        "topology",topology,"wires",wires,"x",x);
endfunction

function p=mo_protocol_1(cfg)
    series=ld1_series_canonical_wires();
    parallel=ld1_parallel_voltage_canonical_wires();
    total=[ld1_parallel_kcl_base_wires();"SRC_P" "M_P";"M_N" "NODE_A1"];
    // Start from the authentic parallel circuit and insert the same ammeter
    // in exactly one branch. No automatic unconnected probe is reported.
    branches=parallel(1:7,:);
    branchR3=[branches([1 2 4 5 6 7],:);"NODE_A2" "M_P";"M_N" "R3_1"];
    branchR2=[branches([1 2 3 4 6 7],:);"NODE_A3" "M_P";"M_N" "R2_1"];
    trials=list();
    trials(1)=mo12_trial("series_1000","1 bandymas · srovė vienoje kilpoje", ...
        msprintf("Šaltinis %g V; keičiamosios varžos VR1 padėtis 1000 Ω nustatyta automatiškai.",cfg.E), ...
        "Pirmiausia pamatuojame srovę, kai grandinės varža didesnė. Ampermetras įjungtas į tą pačią kilpą kaip rezistoriai.","series_A",series,1000);
    trials(2)=mo12_trial("series_500","2 bandymas · sumažinta varža", ...
        msprintf("Šaltinis lieka %g V; VR1 automatiškai pakeista į 500 Ω. Tie patys laidai išlieka.",cfg.E), ...
        "Pamatuojame dar kartą. Ataskaita palygins, kaip pakito srovė sumažinus varžą; nieko skaičiuoti nereikia.","series_A",series,500);
    trials(3)=mo12_trial("parallel_U1000","3 bandymas · dviejų šakų įtampa", ...
        msprintf("Šaltinis %g V; VR1 nustatyta 1000 Ω. Multimetras automatiškai perjungtas į įtampos matavimą.",cfg.E), ...
        "Voltmetrą jungiame tarp abiem šakoms bendrų taškų A ir B. Taip matuojame šakoms tenkančią įtampą.","parallel_V",parallel,1000);
    trials(4)=mo12_trial("parallel_U500","4 bandymas · įtampa pakeitus vieną šaką", ...
        msprintf("Šaltinis lieka %g V; VR1 pakeista į 500 Ω. Voltmetro ir šakų laidai išlieka.",cfg.E), ...
        "Keičiasi vienos šakos varža. Patikriname voltmetro rodmenį; programa pati palygins jį su ankstesniu bandymu.","parallel_V",parallel,500);
    trials(5)=mo12_trial("parallel_Itotal","5 bandymas · bendroji srovė", ...
        "VR1 nustatyta 0 Ω; multimetras perjungtas į srovės matavimą prieš išsišakojimą.", ...
        "Ampermetras dabar yra bendrame srovės kelyje. Vėliau abi šakas pamatuosime tuo pačiu prietaisu atskirai.","parallel_A_main",total,0);
    trials(6)=mo12_trial("parallel_IR3","6 bandymas · srovė R3 šakoje", ...
        "VR1 lieka 0 Ω. Ampermetrą reikia įterpti į R3 šaką; kitos šakos srovė per jį neteka.", ...
        "Matuojame tik R3 šaką. Šio rodmens negalima vadinti bendrąja grandinės srove.","parallel_A_R3",branchR3,0);
    trials(7)=mo12_trial("parallel_IR2","7 bandymas · srovė R2 ir VR1 šakoje", ...
        "VR1 lieka 0 Ω. Ampermetrą perjungiame į R2 ir VR1 šaką.", ...
        "Matuojame antrą šaką. Programa ataskaitoje pati sudės abiejų išmatuotų šakų sroves ir palygins su bendrąja srove.","parallel_A_R2",branchR2,0);
    for k=1:length(trials)
        t=trials(k);t.resistance=t.x;t.panel="parallel";t.meter="A";
        if k<=2 then t.panel="series";end
        if or(k==[3 4]) then t.meter="V";end
        trials(k)=t;
    end
    components=list( ...
        mo12_component("Nuolatinės įtampos šaltinis",["SRC_P";"SRC_N"],["+";"−"]), ...
        mo12_component("Rezistorius R1",["R1_1";"R1_2"],["1";"2"]), ...
        mo12_component("Rezistorius R2",["R2_1";"R2_2"],["1";"2"]), ...
        mo12_component("Rezistorius R3",["R3_1";"R3_2"],["1";"2"]), ...
        mo12_component("Keičiamoji varža VR1",["VR1_1";"VR1_2"],["1";"2"]), ...
        mo12_component("Multimetras · A arba V nustatoma automatiškai",["M_P";"M_N"],["+";"COM"]), ...
        mo12_component("Taškas A · visi keturi lizdai bendri",["NODE_A1";"NODE_A2";"NODE_A3";"NODE_A4"],["A1";"A2";"A3";"A4"]), ...
        mo12_component("Taškas B · visi keturi lizdai bendri",["NODE_B1";"NODE_B2";"NODE_B3";"NODE_B4"],["B1";"B2";"B3";"B4"]));
    p=struct("lab","LD1","title","Nuolatinės srovės grandinės matavimai", ...
        "aim","Sujungti vieną kilpą ir dvi šakas, pamatuoti jų įtampą bei sroves. Jūs tik jungiate laidus ir perrašote prietaiso rodmenį; skaičiavimus ir išvadas parengia programa.", ...
        "background",["Rezistorius riboja srovę. Mažesnė bendra varža prie tos pačios įtampos leidžia tekėti didesnei srovei."; ...
        "Ampermetras matuoja srovę ir jungiamas į jos kelią. Voltmetras matuoja įtampą ir jungiamas tarp dviejų taškų."; ...
        "Naudojamas tas pats originalus idealios virtualios grandinės modelis. A ir B lizdų grupės yra atitinkamai du bendri elektriniai taškai."], ...
        "trials",trials,"components",components,"xlabel","Keičiamoji varža VR1, Ω");
endfunction

function r=mo_measure_1(cfg,t,wires)
    if ~mo_wires_equal(wires,t.wires) then error("LD1: laidai neatitinka šio matavimo grandinės. Pataisykite pažymėtus kontaktus.");end
    // The submitted undirected graph is already proven exactly equivalent.
    // Stable ordering avoids roundoff differences from union-find node order.
    wires=t.wires;
    bench_core_require();
    global LD1;
    LD1=struct("cfg",cfg,"panel",t.panel,"meterMode",t.meter,"VR1",t.resistance, ...
        "realistic",%f,"powerOn",%t,"wires",wires,"term",struct("ids",ld1_terminal_ids()));
    ld1_update_actual_values();
    [value,unit,ok,msg,sol]=ld1_meter_read();
    if ~ok then error("LD1 prietaiso modelis: "+msg);end
    mo12_finite(value,"LD1");
    select t.key
    case "series_1000" then id="I_series";name="Ampermetro rodmuo nuoseklioje grandinėje";
    case "series_500" then id="I_series";name="Ampermetro rodmuo nuoseklioje grandinėje";
    case "parallel_U1000" then id="U_parallel";name="Voltmetro rodmuo tarp A ir B";
    case "parallel_U500" then id="U_parallel";name="Voltmetro rodmuo tarp A ir B";
    case "parallel_Itotal" then id="I_main";name="Ampermetro rodmuo prieš išsišakojimą";
    case "parallel_IR3" then id="I_R3";name="Ampermetro rodmuo R3 šakoje";
    case "parallel_IR2" then id="I_R2";name="Ampermetro rodmuo R2 ir VR1 šakoje";
    else error("Nežinomas LD1 bandymas.");
    end
    r=struct("ids",id,"names",name,"units",unit,"values",value);
endfunction

function lines=mo_analysis_1(cfg,records)
    i1=mo12_value(records,"series_1000","I_series");i2=mo12_value(records,"series_500","I_series");
    u1=mo12_value(records,"parallel_U1000","U_parallel");u2=mo12_value(records,"parallel_U500","U_parallel");
    im=mo12_value(records,"parallel_Itotal","I_main");ia=mo12_value(records,"parallel_IR3","I_R3");ib=mo12_value(records,"parallel_IR2","I_R2");
    lines=["Nuoseklioje grandinėje, kai VR1 = 1000 Ω, ampermetru išmatuota "+mo_num(i1)+" mA; kai VR1 = 500 Ω – "+mo_num(i2)+" mA. Sumažinus varžą srovė padidėjo."; ...
        "Programos apskaičiuotas srovės padidėjimas: "+mo_num(100*(i2/i1-1))+" %. Pagal nustatytą šaltinio įtampą ir matavimus programos apskaičiuotos bendros varžos yra "+mo_num(1000*cfg.E/i1)+" Ω ir "+mo_num(1000*cfg.E/i2)+" Ω."; ...
        "Dviejų šakų įtampa: prie VR1 = 1000 Ω išmatuota "+mo_num(u1)+" V, prie VR1 = 500 Ω – "+mo_num(u2)+" V. Idealus "+mo_num(cfg.E)+" V šaltinis išlaiko įtampą, nors pakeitus šakos varžą jos srovė gali keistis."; ...
        "Atskirais ampermetro perjungimais išmatuota: bendroji srovė "+mo_num(im)+" mA, R3 šakos srovė "+mo_num(ia)+" mA ir R2 bei VR1 šakos srovė "+mo_num(ib)+" mA."; ...
        "Programos apskaičiuota dviejų šakų srovių suma yra "+mo_num(ia+ib)+" mA; jos skirtumas nuo išmatuotos bendrosios srovės – "+mo_num(abs(im-ia-ib))+" mA. Tai patvirtina srovės pasiskirstymą mazge: į jį atitekanti srovė lygi iš šakų srovių sudarytai sumai."; ...
        "Visos čia nurodytos srovės ir įtampos yra atliktų virtualios grandinės bandymų prietaisų rodmenys. Varžas, procentą ir srovių sumą apskaičiavo programa, studentui jų skaičiuoti ar rinktis išvados nereikėjo."];
endfunction

function t=mo12_ac_trial(key,title,phase,target,frequency,why,include_current)
    probes=ld2_probe_pair(phase,target);
    if size(probes,"*")<>2 then error("LD2: nežinomas voltmetro taikinys.");end
    wires=[ld2_required_main(phase);"VM_H" probes(1);"VM_L" probes(2)];
    t=mo12_trial(key,title,msprintf("%s grandinė; generatoriaus dažnis automatiškai nustatytas %.8g Hz. Prietaisai matuoja efektines reikšmes.",phase,frequency), ...
        why,phase+"_"+target,wires,frequency);
    t.phase=phase;t.target=target;t.frequency=frequency;t.include_current=include_current;
endfunction

function p=mo_protocol_2(cfg)
    rr=ld2_resonance_values(cfg.R13,cfg.L3,cfg.C4);
    trials=list( ...
        mo12_ac_trial("rc_R","1 bandymas · RC rezistoriaus įtampa ir srovė","RC","UR",cfg.F_RC,"Pamatuojame srovę bendrame kelyje ir įtampą ties rezistoriumi R8.",%t), ...
        mo12_ac_trial("rc_C","2 bandymas · kondensatoriaus įtampa","RC","UC",cfg.F_RC,"Tos pačios RC grandinės voltmetrą perjungiame ties kondensatoriumi C2. Srovės pakartotinai perrašyti nereikia.",%f), ...
        mo12_ac_trial("rc_E","3 bandymas · RC generatoriaus įtampa","RC","UE",cfg.F_RC,"Voltmetru pamatuojame patį RC generatorių. Ataskaita palygins šį rodmenį su dviem jau išmatuotomis elementų įtampomis.",%f), ...
        mo12_ac_trial("rl_R","4 bandymas · RL rezistoriaus įtampa ir srovė","RL","UR",cfg.F_RL,"Sujungiame rezistorių R9 ir ritę L1. Pamatuojame srovę bendrame kelyje bei įtampą ties R9.",%t), ...
        mo12_ac_trial("rl_L","5 bandymas · ritės įtampa","RL","UL",cfg.F_RL,"Tos pačios RL grandinės voltmetrą perjungiame ties rite L1.",%f), ...
        mo12_ac_trial("rl_E","6 bandymas · RL generatoriaus įtampa","RL","UE",cfg.F_RL,"Pamatuojame RL generatoriaus įtampą. Elementų įtampų palyginimą ataskaitoje atlieka programa.",%f), ...
        mo12_ac_trial("rlc_low","7 bandymas · RLC mažesnis dažnis","RLC","UR",rr.F1,"Pirmas dažnio taškas. Pamatuojame rezistoriaus R13 įtampą ir bendrą srovę; kiti du taškai parodys jų pokytį.",%t), ...
        mo12_ac_trial("rlc_mid","8 bandymas · RLC vidurinis dažnis","RLC","UR",rr.F0,"Dažnis pakeistas automatiškai, laidai išlieka. Pamatuojame tuos pačius du dydžius ir palyginsime trijų bandymų rodmenis.",%t), ...
        mo12_ac_trial("rlc_high","9 bandymas · RLC didesnis dažnis","RLC","UR",rr.F2,"Trečias dažnio taškas su tais pačiais laidais. Programa pati nustatys, kuriame iš trijų taškų rodmenys didžiausi.",%t), ...
        mo12_ac_trial("rlc_L","10 bandymas · ritės įtampa RLC grandinėje","RLC","UL",rr.F0,"Grįžtame prie vidurinio dažnio ir voltmetrą prijungiame ties rite L3. Įtampa ties vienu elementu gali viršyti generatoriaus įtampą.",%f), ...
        mo12_ac_trial("rlc_C","11 bandymas · kondensatoriaus įtampa RLC grandinėje","RLC","UC",rr.F0,"Prie to paties dažnio voltmetrą perjungiame ties kondensatoriumi C4.",%f), ...
        mo12_ac_trial("rlc_LC","12 bandymas · bendra ritės ir kondensatoriaus įtampa","RLC","ULC",rr.F0,"Voltmetrą prijungiame per visą L3 ir C4 porą. Pamatuojame jų bendrą įtampą; ataskaita paaiškins, kodėl ji maža, nors atskiros įtampos didelės.",%f));
    components=list( ...
        mo12_component("Generatorius · galios ir matavimo lizdai",["GEN_H";"GEN_L";"GEN_MH";"GEN_ML"],["~";"0";"M~";"M0"]), ...
        mo12_component("Ampermetras A~",["AM_H";"AM_L"],["~";"COM"]), ...
        mo12_component("Voltmetras V~",["VM_H";"VM_L"],["~";"COM"]), ...
        mo12_component("RC rezistorius R8",["R8_1";"R8_2";"R8_M1";"R8_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("RC kondensatorius C2",["C2_1";"C2_2";"C2_M1";"C2_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("RL rezistorius R9",["R9_1";"R9_2";"R9_M1";"R9_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("RL ritė L1",["L1_1";"L1_2";"L1_M1";"L1_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("RLC rezistorius R13",["R13_1";"R13_2";"R13_M1";"R13_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("RLC ritė L3",["L3_1";"L3_2";"L3_M1";"L3_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("RLC kondensatorius C4",["C4_1";"C4_2";"C4_M1";"C4_M2"],["1";"2";"M1";"M2"]), ...
        mo12_component("L3 ir C4 poros kraštai",["LC_M1";"LC_M2"],["LC1";"LC2"]));
    p=struct("lab","LD2","title","Kintamosios srovės grandinių matavimai", ...
        "aim","Pamatuoti rezistoriaus, ritės ir kondensatoriaus įtampas bei srovę. Laidus jungiate ir rodomus skaičius perrašote patys; dažnį nustato ir palyginimus atlieka programa.", ...
        "background",["RC reiškia rezistorių su kondensatoriumi, RL – rezistorių su rite, RLC – visus tris elementus vienoje grandinėje."; ...
        "Ampermetras jungiamas bendrame srovės kelyje, voltmetras – prie dviejų matuojamo elemento kraštų. M1 ir M2 yra tam skirti matavimo lizdai."; ...
        "Visi rodmenys yra virtualaus kintamosios srovės modelio efektinės (RMS) reikšmės. Generatorius kiekvienam bandymui nustatomas automatiškai; pačiam skaičiuoti ar rinktis dažnio nereikia."], ...
        "trials",trials,"components",components,"xlabel","Generatoriaus dažnis, Hz");
endfunction

function r=mo_measure_2(cfg,t,wires)
    if ~mo_wires_equal(wires,t.wires) then error("LD2: laidai neatitinka šio matavimo grandinės. Patikrinkite grandinę ir abu voltmetro zondus.");end
    wires=t.wires;
    bench_core_require();
    global LD2;
    LD2=struct("cfg",cfg,"state",struct("power",%t,"freq",t.frequency, ...
        "rc_connections",emptystr(0,2),"rl_connections",emptystr(0,2),"rlc_connections",emptystr(0,2)));
    LD2.state(convstr(t.phase,"l")+"_connections")=wires;
    [valid,missing]=ld2_validate_main(t.phase);
    if ~valid then error("LD2: pagrindinė grandinė neužbaigta.");end
    if ld2_detect_voltage_target(t.phase)<>t.target then error("LD2: voltmetras prijungtas ne prie deklaruoto matavimo taikinio.");end
    select t.phase
    case "RC" then model=ld2_rc_values(cfg.E_RC,t.frequency,cfg.R8,cfg.C2);
    case "RL" then model=ld2_rl_values(cfg.E_RL,t.frequency,cfg.R9,cfg.L1);
    case "RLC" then model=ld2_rlc_values(cfg.E_RLC,t.frequency,cfg.R13,cfg.L3,cfg.C4);
    else error("Nežinoma LD2 grandinė.");
    end
    select t.target
    case "UR" then voltage=model.UR;label="rezistoriaus";suffix="R";
    case "UC" then
        if t.phase=="RLC" then voltage=model.UC;else voltage=model.UX;end
        label="kondensatoriaus";suffix="C";
    case "UL" then
        if t.phase=="RLC" then voltage=model.UL;else voltage=model.UX;end
        label="ritės";suffix="L";
    case "UE" then
        voltage=cfg.E_RC;if t.phase=="RL" then voltage=cfg.E_RL;end
        label="generatoriaus";suffix="E";
    case "ULC" then voltage=model.ULC;label="visos ritės ir kondensatoriaus poros";suffix="LC";
    else error("Nežinomas LD2 prietaiso taikinys.");
    end
    id="U_"+t.phase+"_"+suffix;name="Voltmetro rodmuo: "+label+" įtampa";
    if t.include_current then
        r=struct("ids",["I_"+t.phase;id],"names",["Ampermetro rodmuo: "+t.phase+" srovė";name], ...
            "units",["mA";"V"],"values",[1000*model.I;voltage]);
    else r=struct("ids",id,"names",name,"units","V","values",voltage);end
    mo12_finite(r.values,"LD2");
endfunction

function lines=mo_analysis_2(cfg,records)
    rcR=mo12_value(records,"rc_R","U_RC_R");rcC=mo12_value(records,"rc_C","U_RC_C");rcE=mo12_value(records,"rc_E","U_RC_E");
    rlR=mo12_value(records,"rl_R","U_RL_R");rlL=mo12_value(records,"rl_L","U_RL_L");rlE=mo12_value(records,"rl_E","U_RL_E");
    low=mo12_value(records,"rlc_low","U_RLC_R");mid=mo12_value(records,"rlc_mid","U_RLC_R");high=mo12_value(records,"rlc_high","U_RLC_R");
    ilow=mo12_value(records,"rlc_low","I_RLC");imid=mo12_value(records,"rlc_mid","I_RLC");ihigh=mo12_value(records,"rlc_high","I_RLC");
    f1=mo12_frequency(records,"rlc_low");f0=mo12_frequency(records,"rlc_mid");f2=mo12_frequency(records,"rlc_high");
    ul=mo12_value(records,"rlc_L","U_RLC_L");uc=mo12_value(records,"rlc_C","U_RLC_C");ulc=mo12_value(records,"rlc_LC","U_RLC_LC");
    lines=["RC grandinėje išmatuota rezistoriaus įtampa "+mo_num(rcR)+" V, kondensatoriaus įtampa "+mo_num(rcC)+" V ir generatoriaus įtampa "+mo_num(rcE)+" V."; ...
        "Šių kintamųjų įtampų negalima tiesiog sudėti kaip dviejų pastovių įtampų: jų kitimo fazės skiriasi. Programos apskaičiuota geometrinė reikšmė √(UR²+UC²) yra "+mo_num(sqrt(rcR^2+rcC^2))+" V ir sutampa su pamatuota generatoriaus įtampa."; ...
        "RL grandinėje išmatuota rezistoriaus įtampa "+mo_num(rlR)+" V, ritės įtampa "+mo_num(rlL)+" V ir generatoriaus įtampa "+mo_num(rlE)+" V. Programos apskaičiuota √(UR²+UL²) yra "+mo_num(sqrt(rlR^2+rlL^2))+" V."; ...
        "RLC trijų dažnių bandymuose: prie "+mo_num(f1)+" Hz UR = "+mo_num(low)+" V ir I = "+mo_num(ilow)+" mA; prie "+mo_num(f0)+" Hz UR = "+mo_num(mid)+" V ir I = "+mo_num(imid)+" mA; prie "+mo_num(f2)+" Hz UR = "+mo_num(high)+" V ir I = "+mo_num(ihigh)+" mA."; ...
        "Iš šių trijų išmatuotų taškų viduriniame rezistoriaus įtampa ir srovė didžiausios. Tai šio idealaus RLC modelio rezonanso taškas: ritės ir kondensatoriaus poveikiai grandinėje vienas kitą kompensuoja."; ...
        "Prie to paties vidurinio dažnio atskirai perjungtu voltmetru pamatuota UL = "+mo_num(ul)+" V, UC = "+mo_num(uc)+" V ir visos L+C poros ULC = "+mo_num(ulc)+" V. Atskirų elementų įtampos didelės, tačiau jų bendras rodmuo mažas dėl priešingų fazių."; ...
        "Programos apskaičiuotas |UL−UC| = "+mo_num(abs(ul-uc))+" V dera su atskirai pamatuotu ULC. Šis skirtumas nėra papildomas prietaiso matavimas."; ...
        "Du kraštiniai bandymo dažniai parinkti ten, kur UR ir I yra maždaug 0,707 didžiausio rodmens. Programos apskaičiuotas šių dažnių skirtumas f2−f1 = "+mo_num(f2-f1)+" Hz yra šio idealaus modelio dažnių juostos plotis. Studentui šio skirtumo skaičiuoti nereikėjo."; ...
        "Ataskaitos įtampos ir srovės yra tik atliktų virtualių bandymų rodmenys. Kvadratines šaknis, įtampų skirtumą ir dažnių juostą automatiškai apskaičiavo programa; apskaičiuoti dydžiai nevadinami papildomais matavimais."];
endfunction

function value=mo12_value(records,key,id)
    for k=1:length(records)
        rec=records(k);
        if rec.trial.key<>key then continue;end
        hit=find(rec.reading.ids==id);
        if size(hit,"*")<>1 then error("Trūksta vienareikšmio prietaiso rodmens: "+key+" / "+id);end
        value=rec.reading.values(hit(1));mo12_finite(value,"Ataskaitos rodmuo");return;
    end
    error("Trūksta atlikto bandymo: "+key);
endfunction

function value=mo12_frequency(records,key)
    for k=1:length(records)
        if records(k).trial.key==key then value=records(k).trial.frequency;return;end
    end
    error("Trūksta atlikto dažnio bandymo: "+key);
endfunction

function mo12_finite(values,lab)
    if type(values)<>1 | size(values,"*")==0 then error(lab+": prietaisas negrąžino skaitinio rodmens.");end
    if ~isreal(values) | or(isnan(values)) | or(isinf(values)) then error(lab+": prietaiso rodmuo nebaigtinis arba kompleksinis.");end
endfunction
